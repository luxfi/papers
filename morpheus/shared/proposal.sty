% proposal.sty — shared style for Hanzo/Lux <-> Morpheus proposal documents.
%
% One style for both shapes in this directory. A one-pager calls \proposalhead
% and stays on a single page; the whitepaper calls \proposalcover and runs long.
% Neither carries a vendor logo: these are proposals to another engineering team
% and they should read as joint work, not as a pitch deck.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{proposal}[2026/08/28 Morpheus proposal documents]

\RequirePackage{geometry}\geometry{margin=0.9in}
\RequirePackage{xcolor}
\RequirePackage{titlesec}
\RequirePackage{enumitem}
\RequirePackage{booktabs}
\RequirePackage{hyperref}

\definecolor{rule}{HTML}{C9CFD8}
\definecolor{muted}{HTML}{5C6472}
\definecolor{accent}{HTML}{1F4788}

\hypersetup{colorlinks=true,linkcolor=black,citecolor=accent,urlcolor=accent}

% Tighter, quieter headings than article's defaults. A one-pager cannot afford
% article's vertical space and a whitepaper reads better without it either.
\titleformat{\section}{\normalfont\large\bfseries}{\thesection}{0.6em}{}
\titlespacing*{\section}{0pt}{1.4ex plus .3ex}{0.6ex}
\titleformat{\subsection}{\normalfont\normalsize\bfseries}{\thesubsection}{0.6em}{}
\titlespacing*{\subsection}{0pt}{1.1ex plus .2ex}{0.4ex}

\setlist[itemize]{leftmargin=1.1em,itemsep=0.25ex,topsep=0.4ex,parsep=0pt}
\setlist[description]{leftmargin=0pt,style=nextline,itemsep=0.5ex,topsep=0.5ex}

% \proposalhead{title}{one-line thesis}{docket}
% The docket is the paper this one-pager stands for, e.g. "LP-315".
\newcommand{\proposalhead}[3]{%
  \thispagestyle{empty}%
  \noindent{\color{muted}\footnotesize\sffamily #3 \quad\textbullet\quad Hanzo AI \& Lux Industries \quad\textbullet\quad 2026}\par
  \vspace{0.7ex}
  \noindent{\LARGE\bfseries #1}\par
  \vspace{0.9ex}
  \noindent{\color{rule}\rule{\linewidth}{1.1pt}}\par
  \vspace{1.0ex}
  \noindent{\itshape #2}\par
  \vspace{1.4ex}%
}

% \proposalcover{title}{subtitle}
\newcommand{\proposalcover}[2]{%
  \thispagestyle{empty}%
  \vspace*{2.2in}
  \noindent{\color{rule}\rule{\linewidth}{1.1pt}}\par
  \vspace{1.4ex}
  \noindent{\Huge\bfseries #1}\par
  \vspace{1.6ex}
  \noindent{\large\itshape #2}\par
  \vspace{1.4ex}
  \noindent{\color{rule}\rule{\linewidth}{1.1pt}}\par
  \vfill
  \noindent{\color{muted}\footnotesize\sffamily
    Hanzo AI, Inc. \quad\textbullet\quad Lux Industries, Inc.\\
    Zach Kelling \quad\textbullet\quad \texttt{research@lux.network}\\
    2026}\par
  \clearpage
}

% A short labelled block for "what each side gets" and similar pairings, which
% is the move every one of these documents needs and article has no form for.
\newenvironment{stake}[1]{%
  \vspace{0.7ex}\noindent{\bfseries #1}\par\nopagebreak\vspace{0.2ex}%
  \begin{itemize}[leftmargin=1.1em]%
}{%
  \end{itemize}\vspace{0.4ex}%
}
