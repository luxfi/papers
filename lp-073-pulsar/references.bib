@misc{corona,
  author       = {{Lux Industries}},
  title        = {Corona: Two-Round Module-LWE Threshold Signatures},
  year         = {2026},
  howpublished = {\url{https://github.com/luxfi/corona}},
  note         = {Lux's own threshold scheme: Module-LWE (Ringtail/Raccoon
                  lineage), a rank-$8\times7$ module over $R_q =
                  \mathbb{Z}_q[X]/(X^{256}+1)$ with a 48-bit prime $q =
                  \mathtt{0x1000000004A01}$ --- \emph{not} Ring-LWE (rank~1).
                  Two-round, natively dealerless (Pedersen-VSS, noise-flooded),
                  no-reconstruct signing. Builds on the Ringtail line
                  (\cite{ringtail}); cited via this Lux artifact, never via
                  the academic paper. Companion hardness is Module-SIS.}
}

